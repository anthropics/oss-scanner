FROM quay.io/archlinux/archlinux:latest AS build-base

# full system upgrade just to be sure
RUN pacman -Syu --noconfirm

# test-only libraries and such
ENV EXTRA_TOOLS="cmocka protobuf protobuf-c python-pip"

# build dependencies for all versions we could want to test
ENV BIND_MAKEDEPENDS="autoconf automake base-devel git libtool meson ninja pkgconf python python-ply python-sphinx"

# runtime dependencies - list generated by
# ldd `which named` | sed -n -e 's/.*=> \(\/.*\) (0x[0-9a-f]*)/\1/p' | xargs -n1 pacman -Fq | cut -d / -f2 | sort -u
ENV BIND_DEPENDS="e2fsprogs fstrm gcc-libs glibc icu jemalloc json-c keyutils krb5 libcap libmaxminddb libnghttp2 liburcu libuv libxml2 lmdb openssl protobuf-c zlib"

RUN pacman -Syu --noconfirm ${EXTRA_TOOLS} ${BIND_MAKEDEPENDS} ${BIND_DEPENDS}

COPY . /src
WORKDIR /src

RUN python -m pip install --break-system-packages -r /src/bin/tests/system/requirements.txt
RUN python -m pip install --break-system-packages -r /src/tests/requirements.txt
# Sphinx for docs omitted

# guard against pulling in named binary accidentally
RUN which named && exit 1 || echo "Ok, no named binary found"

RUN if [ -f meson.build ]; then \
    meson setup --libdir=lib --prefix=/usr build && \
    ninja -C build -l $(nproc) all system-test-dependencies && \
    ninja -C build install; \
    meson test -C build --suite cmocka || echo "unit test failure"; \
else \
    autoreconf -fiv && \
    ./configure --without-python --disable-linux-caps --prefix=/usr && \
    make -j$(nproc) -l$(nproc) && \
    make install; \
    make test || echo "unit test failure"; \
fi

# CVE scoring guidelines and related procedures
RUN curl --output isc-cvss-scoring-guidelines.md https://kb.isc.org/docs/isc-cvss-scoring-guidelines.md
RUN curl --output aa-00861.md https://kb.isc.org/docs/aa-00861.md
