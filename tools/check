"""
Build a project the same way the scanner does, then open a shell in the environment so you can test it.

    tools/check <name>            build projects/<name> with your local Docker
    tools/check --qemu <name>     build it inside virtual machines set up like the scanner's

This will run the following five operations:

    1. Check projects/<name>/ against the enrolment rules (tools/validate.py).
    2. Clone `repo` anonymously, at the branch or tag you specified.
    3. Build your Dockerfile, using the checkout as the build context. The network is available.
    4. Add the scanner's layer, including Claude Code, compilers and debuggers.
    5. Start the finished image with networking disabled and open a root bash shell in /src.

From this shell, you can then run your tests. If everything works, the scanner should also be able to function.

Security note: your Dockerfile is built with network access. --qemu builds it inside a virtual machine, which keeps
it off your files, but it can still reach services on this computer and your local network. Check a project from
someone you don't trust on a machine with nothing to lose.

Exit codes: 0 if the project builds, 1 if it does not, 2 if projects/<name>/ breaks the enrolment rules.

Requires git, Docker and PyYAML (pip install pyyaml). With --qemu, requires Linux on x86-64 with
qemu-system-x86_64 and qemu-img instead of Docker (see tools/check_qemu.py). Everything is kept in
~/.cache/oss-scanner-check, or in --dir if given.
"""

import argparse
import os
import pathlib
import shutil
import subprocess
import sys
import types

import check_build
import validate
from check_build import AGENT_MACHINE, CACHE, Failed, Job, banner, image, say


def load(project):
    """
    Validate a project and return (directory, Job). Exit with code 2 if it breaks the enrolment rules.
    `project` is either a name under projects/ or the path of a directory containing a project.yaml.
    """
    directory = pathlib.Path(project)
    if not (directory / "project.yaml").exists() and len(directory.parts) == 1:
        directory = validate.PROJECTS / project
    directory = directory.absolute()
    problems, _ = validate.check_project(directory)
    if problems:
        for problem in problems:
            print(validate.printable(f"{directory.name}: {problem}"), file=sys.stderr)
        sys.exit(2)

    config = validate.yaml.safe_load((directory / "project.yaml").read_text(encoding="utf-8"))
    repo, _, ref = config["repo"].partition("#")
    beside = {path.name for path in directory.iterdir()}
    return directory, Job(
        name=directory.name,
        repo=repo,
        ref=ref,
        dockerfile="" if "Dockerfile" in beside else config["dockerfile"],
        threat_model="" if "threat_model.md" in beside else config.get("threat_model") or ".oss-scanner/threat_model.md",
    )


# The three functions below are the Docker backend. tools/check_qemu.py defines the same three for --qemu.

def require():
    """Exit if git or docker is not installed."""
    for command in ("git", "docker"):
        if not shutil.which(command):
            sys.exit(f"tools/check needs {command}")


def build(job, share, work):
    """Run the full build with local Docker. Raise Failed if it fails."""
    check_build.build(job, share, work / "src")


def shell(job, work):
    """Open bash in the finished image, with no network, an agent's CPUs and memory, and none of your files mounted."""
    banner(
        job,
        "in a container of your own Docker",
        "exit or Ctrl-D ends it, and nothing you did in it is kept.",
    )
    limits = ["--cpus", str(min(AGENT_MACHINE["cpus"], os.cpu_count() or 1)), "--memory", f"{AGENT_MACHINE['mem_gb']}g"]
    # The scanner's container is privileged, so debuggers and LeakSanitizer work there. SYS_PTRACE lets them work here.
    container = ["--rm", "-i", "--init", "--network", "none", "--cap-add", "SYS_PTRACE", *limits, "-w", "/src"]
    if sys.stdin.isatty():
        container.append("-t")
    subprocess.call(["docker", "run", *container, image("built", job.name), "bash"])
    return True


DOCKER = types.SimpleNamespace(require=require, build=build, shell=shell)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("project", help="a name under projects/, or the path of a directory with a project.yaml")
    parser.add_argument("--qemu", action=argparse.BooleanOptionalAction, default=False, help="in virtual machines")
    parser.add_argument("--no-shell", action="store_true", help="stop after the build")
    parser.add_argument("--dir", type=pathlib.Path, help=f"where to work (default: {CACHE}/<name>)")
    options = parser.parse_args()

    directory, job = load(options.project)
    work = (options.dir or CACHE / job.name).absolute()
    work.mkdir(parents=True, exist_ok=True, mode=0o700)
    mode = DOCKER
    if options.qemu:
        import check_qemu as mode  # imported only when needed, because it only works on Linux
    mode.require()

    share = work / "job"
    shutil.rmtree(share, ignore_errors=True)
    share.mkdir()
    job.save(share)
    if not job.dockerfile:
        shutil.copyfile(directory / "Dockerfile", share / "Dockerfile")
    try:
        mode.build(job, share, work)
    except Failed as failure:
        say(f"\nBUILD FAILED: {failure}")
        return 1
    say(f"\n{job.name} builds.")

    if options.no_shell or mode.shell(job, work):
        return 0
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
